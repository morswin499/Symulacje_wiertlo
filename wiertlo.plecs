        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "cs_par"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"#define PI_F    3.14159265358979\n"
"#define SQRT3   1.73205080756888\n"
"#define FIFO_N  32\n"
"\n"
"typedef struct { long long kp, ki, outMax, integ; int kps, kis; } PI_t;\n"
"\n"
"static PI_t piD, piQ, piW;\n"
"static double Kcur, Ts, pp, maxmod, hallTimeout;\n"
"static int Ndec, Nfifo, decCnt;\n"
"static long long IqRef;\n"
"\n"
"/* hall */\n"
"static int    secPrev, dir, edgeValid, fifoIdx, fifoCnt;\n"
"static double t, tEdge, thEprev, bnd, wEl;\n"
"static double fifo[FIFO_N];\n"
"\n"
"/* wyjscia (liczone w Update, wystawiane w Output = 1 probka opoznienia) */\n"
"static double mOut[3], dbg[8];\n"
"\n"
"/* PI 1:1 jak PI_Controller() w MCSDK */\n"
"static long long PI_Run(PI_t *c, long long err)\n"
"{\n"
"  long long out, dis = 0, iMax = c->outMax << c->kis;\n"
"  c->integ += c->ki * err;\n"
"  if (c->integ >  iMax) c->integ =  iMax;\n"
"  if (c->integ < -iMax) c->integ = -iMax;\n"
"  out = ((c->kp * err) >> c->kps) + (c->integ >> c->kis);\n"
"  if (out >  c->outMax) { dis =  c->outMax - out; out =  c->outMax; }\n"
"  if (out < -c->outMax) { dis = -c->outMax - out; out = -c->outMax; }\n"
"  c->integ += dis;\n"
"  return out;\n"
"}\n"
"\n"
"static double wrapPi(double x)\n"
"{\n"
"  while (x >  PI_F) x -= 2*PI_F;\n"
"  while (x < -PI_F) x += 2*PI_F;\n"
"  return x;\n"
"}\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "Kcur   = ParamRealData(0,0);\n"
"Ts     = ParamRealData(0,1);\n"
"pp     = ParamRealData(0,2);\n"
"piQ.kp = piD.kp = (long long)ParamRealData(0,3);\n"
"piQ.ki = piD.ki = (long long)ParamRealData(0,4);\n"
"piQ.kps = piD.kps = (int)ParamRealData(0,5);\n"
"piQ.kis = piD.kis = (int)ParamRealData(0,6);\n"
"piQ.outMax = piD.outMax = 32767;\n"
"piW.kp  = (long long)ParamRealData(0,7);\n"
"piW.ki  = (long long)ParamRealData(0,8);\n"
"piW.kps = (int)ParamRealData(0,9);\n"
"piW.kis = (int)ParamRealData(0,10);\n"
"piW.outMax = (long long)ParamRealData(0,11);   /* limit Iq [s16A] */\n"
"Ndec   = (int)ParamRealData(0,12);             /* fpwm / fspd      */\n"
"Nfifo  = (int)ParamRealData(0,13);  if (Nfifo > FIFO_N) Nfifo = FIFO_N;\n"
"maxmod = ParamRealData(0,14);\n"
"hallTimeout = ParamRealData(0,15);\n"
"\n"
"piD.integ = piQ.integ = piW.integ = 0;\n"
"IqRef = 0; decCnt = 0;\n"
"t = 0; tEdge = 0; edgeValid = 0; fifoIdx = 0; fifoCnt = 0;\n"
"wEl = 0; dir = 1; secPrev = -1; thEprev = 0; bnd = 0;\n"
"mOut[0] = mOut[1] = mOut[2] = 0;"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "{\n"
"  int k;\n"
"  for (k = 0; k < 3; k++) OutputSignal(0,k) = mOut[k];\n"
"  for (k = 0; k < 8; k++) OutputSignal(1,k) = dbg[k];\n"
"}"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "\n"
"\n"
"\n"
"/* ======================= Update function ======================= */\n"
"{\n"
"  double ia = InputSignal(0,0), ib = InputSignal(0,1);\n"
"  double thM = InputSignal(0,3), nRef = InputSignal(0,4);\n"
"  double thE, thEst, c, s, avg, el, adv;\n"
"  int sec, k;\n"
"\n"
"  t += Ts;\n"
"\n"
"  /* ---------- emulacja hallotronow (sektory 60 st. el.) ---------- */\n"
"  thE = fmod(pp*thM, 2*PI_F);  if (thE < 0) thE += 2*PI_F;\n"
"  sec = (int)(thE / (PI_F/3)); if (sec > 5) sec = 5;\n"
"\n"
"  if (secPrev < 0) {                       /* start: srodek sektora */\n"
"    secPrev = sec; bnd = sec*PI_F/3 + PI_F/6;\n"
"  } else if (sec != secPrev) {\n"
"    int d = sec - secPrev;\n"
"    double dth, dEdge, frac, tE;\n"
"    if (d == 1 || d == -5) dir = 1; else if (d == -1 || d == 5) dir = -1;\n"
"    bnd = (dir > 0) ? sec*PI_F/3 : (sec+1)*PI_F/3;\n"
"\n"
"    /* dokladny czas zbocza (MCU ma timer capture, nie probkowanie) */\n"
"    dth   = wrapPi(thE - thEprev);\n"
"    dEdge = wrapPi(bnd - thEprev);\n"
"    frac  = (fabs(dth) > 1e-12) ? dEdge/dth : 1.0;\n"
"    if (frac < 0) frac = 0; if (frac > 1) frac = 1;\n"
"    tE = t - Ts + frac*Ts;\n"
"\n"
"    if (edgeValid) {\n"
"      fifo[fifoIdx] = tE - tEdge;\n"
"      fifoIdx = (fifoIdx + 1) % Nfifo;\n"
"      if (fifoCnt < Nfifo) fifoCnt++;\n"
"    }\n"
"    tEdge = tE; edgeValid = 1; secPrev = sec;\n"
"  }\n"
"  thEprev = thE;\n"
"\n"
"  /* ---------- predkosc z okresow miedzy zboczami ---------- */\n"
"  el = t - tEdge;\n"
"  if (fifoCnt > 0 && el < hallTimeout) {\n"
"    avg = 0; for (k = 0; k < fifoCnt; k++) avg += fifo[k]; avg /= fifoCnt;\n"
"    if (el > avg) avg = el;                /* silnik zwalnia */\n"
"    wEl = dir * (PI_F/3) / avg;\n"
"  } else {\n"
"    wEl = 0; fifoCnt = 0; fifoIdx = 0;     /* timeout -> 0 */\n"
"  }\n"
"\n"
"  /* ---------- kat: zbocze + ekstrapolacja (max 60 st.) ---------- */\n"
"  adv = (edgeValid && fifoCnt > 0) ? fabs(wEl)*el : 0;\n"
"  if (adv > PI_F/3) adv = PI_F/3;\n"
"  thEst = bnd + dir*adv;\n"
"\n"
"  /* ---------- petla predkosci (co Ndec probek) ---------- */\n"
"  if (++decCnt >= Ndec) {\n"
"    long long spd01 = (long long)(wEl/pp/(2*PI_F)*10.0);  /* 0.1 Hz */\n"
"    long long ref01 = (long long)(nRef/6.0);              /* rpm->0.1Hz */\n"
"    decCnt = 0;\n"
"    IqRef = PI_Run(&piW, ref01 - spd01);\n"
"  }\n"
"\n"
"  /* ---------- pomiar pradu (12-bit ADC = krok 16 w s16A) ---------- */\n"
"  {\n"
"    double Ia = 16.0*floor(ia*Kcur/16.0 + 0.5);\n"
"    double Ib = 16.0*floor(ib*Kcur/16.0 + 0.5);\n"
"    double Ial = Ia, Ibe = (Ia + 2.0*Ib)/SQRT3;\n"
"    double Id, Iq, Vd, Vq, Val, Vbe, u[3], umax, umin, u0, Vmax;\n"
"\n"
"    c = cos(thEst); s = sin(thEst);\n"
"    Id =  Ial*c + Ibe*s;\n"
"    Iq = -Ial*s + Ibe*c;\n"
"\n"
"    Vd = (double)PI_Run(&piD, 0     - (long long)Id);\n"
"    Vq = (double)PI_Run(&piQ, IqRef - (long long)Iq);\n"
"\n"
"    /* circle limitation (jak MCSDK: Vd ma priorytet) */\n"
"    Vmax = maxmod*32767.0;\n"
"    if (Vd*Vd + Vq*Vq > Vmax*Vmax) {\n"
"      if (Vd >  Vmax) Vd =  Vmax;\n"
"      if (Vd < -Vmax) Vd = -Vmax;\n"
"      Vq = (Vq >= 0 ? 1 : -1) * sqrt(Vmax*Vmax - Vd*Vd);\n"
"    }\n"
"\n"
"    /* odwrotny Park + SVPWM (wstrzykniecie min-max) */\n"
"    Val = Vd*c - Vq*s;  Vbe = Vd*s + Vq*c;\n"
"    u[0] = Val/32768.0;\n"
"    u[1] = (-0.5*Val + 0.5*SQRT3*Vbe)/32768.0;\n"
"    u[2] = (-0.5*Val - 0.5*SQRT3*Vbe)/32768.0;\n"
"    umax = u[0]; umin = u[0];\n"
"    for (k = 1; k < 3; k++) { if (u[k] > umax) umax = u[k]; if (u[k] < umin) "
"umin = u[k]; }\n"
"    u0 = -0.5*(umax + umin);\n"
"    for (k = 0; k < 3; k++) {\n"
"      double m = (u[k] + u0) * 2.0/SQRT3;\n"
"      if (m > 1) m = 1; if (m < -1) m = -1;\n"
"      mOut[k] = m;\n"
"    }\n"
"\n"
"    dbg[0] = wEl/pp*60.0/(2*PI_F);\n"
"    dbg[1] = fmod(thEst + 2*PI_F, 2*PI_F);\n"
"    dbg[2] = thE;\n"
"    dbg[3] = Id/Kcur;  dbg[4] = Iq/Kcur;  dbg[5] = (double)IqRef/Kcur;\n"
"    dbg[6] = Vd;       dbg[7] = Vq;\n"
"  }\n"
"}"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
